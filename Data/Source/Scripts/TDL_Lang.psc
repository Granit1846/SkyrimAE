ScriptName TDL_Lang Hidden

; Labels of the radial/list menus (UIExtensions has no translation files): Russian when the game language is Russian.
; shortcut: only EN/RU; add more languages here or move menus to $ keys when UIExtensions translation is confirmed.
String Function T(String en) Global
